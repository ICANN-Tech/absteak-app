APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absteak_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MongoDB Configuration
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=absteak_db
MONGO_USERNAME=admin
MONGO_PASSWORD=admin_password_2024

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ejabberd Chat Configuration
EJABBERD_HOST=ejabberd
EJABBERD_PORT=5280
EJABBERD_ADMIN_USER=admin
EJABBERD_ADMIN_PASSWORD=admin_password_2024
EJABBERD_DOMAIN=absteak.local

# Chat Settings
CHAT_GUEST_PREFIX=guest_
CHAT_CS_GROUP=customer_service
CHAT_DEFAULT_ROOM=support
CHAT_WEBSOCKET_URL=ws://localhost:5280/ws
CHAT_BOSH_URL=http://localhost:5280/http-bind
CHAT_ALLOW_GUEST=true
CHAT_AUTO_ASSIGN_CS=true
CHAT_MAX_CONCURRENT=5
CHAT_TIMEOUT=1800

VITE_APP_NAME="${APP_NAME}"
