# ==============================================
# Laravel Email Configuration - DEVELOPMENT
# ==============================================
# This configuration uses Mailpit for development/testing
# All emails will be captured and viewable at http://localhost:8025

# Email Environment
EMAIL_ENVIRONMENT=development

# Mail Configuration for Development (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@absteak.local
MAIL_FROM_NAME="ABSteak App (Development)"

# Alternative: Use log driver for file-based email testing
# MAIL_MAILER=log

# ==============================================
# Usage Instructions:
# ==============================================
# 1. Copy these settings to your .env file
# 2. Start Docker containers: docker-compose up -d
# 3. Access Mailpit web interface: http://localhost:8025
# 4. Send test emails from your Laravel app
# 5. View captured emails in Mailpit interface

# ==============================================
# Testing Commands:
# ==============================================
# Test email sending:
# docker-compose exec app php artisan tinker
# Mail::raw('Test email', function($msg) { $msg->to('test@example.com')->subject('Test'); });