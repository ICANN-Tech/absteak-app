# ==============================================
# Laravel Email Configuration - PRODUCTION
# ==============================================
# This configuration uses Postfix for real email sending
# and Dovecot for email storage/retrieval

# Email Environment
EMAIL_ENVIRONMENT=production

# Mail Configuration for Production (Postfix)
MAIL_MAILER=smtp
MAIL_HOST=postfix
MAIL_PORT=587
MAIL_USERNAME=admin
MAIL_PASSWORD=admin_password_2024
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@absteak.local
MAIL_FROM_NAME="ABSteak App"

# Alternative Production Settings:
# For external SMTP providers (Gmail, SendGrid, etc.)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# ==============================================
# IMAP/POP3 Configuration (Dovecot)
# ==============================================
# For reading emails programmatically in Laravel
# You can use packages like webklex/laravel-imap

# IMAP Settings
IMAP_HOST=dovecot
IMAP_PORT=143
IMAP_ENCRYPTION=false
IMAP_VALIDATE_CERT=false
IMAP_USERNAME=admin
IMAP_PASSWORD=admin_password_2024
IMAP_DEFAULT_ACCOUNT=default

# IMAP SSL Settings (for port 993)
# IMAP_PORT=993
# IMAP_ENCRYPTION=ssl
# IMAP_VALIDATE_CERT=true

# ==============================================
# Security Notes:
# ==============================================
# 1. Change default passwords in production
# 2. Use strong, unique passwords
# 3. Consider using environment-specific secrets
# 4. Enable SSL/TLS encryption for external access
# 5. Configure proper firewall rules
# 6. Regular security updates for mail servers

# ==============================================
# DNS Configuration Required:
# ==============================================
# Add these DNS records for your domain:
# MX    @    10 mail.yourdomain.com
# A     mail    YOUR_SERVER_IP
# TXT   @    "v=spf1 mx ~all"
# TXT   _dmarc    "v=DMARC1; p=quarantine; rua=mailto:dmarc@yourdomain.com"