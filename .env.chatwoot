# Chatwoot Configuration
RAILS_ENV=production
NODE_ENV=production

# Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=absteak_user
POSTGRES_PASSWORD=absteak_password

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application Configuration
SECRET_KEY_BASE=your_secret_key_base_here_change_this_in_production
FRONTEND_URL=http://localhost:3002
FORCE_SSL=false

# Email Configuration (optional)
MAILER_SENDER_EMAIL=support@absteak.com
SMTP_DOMAIN=absteak.com
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=true

# Storage Configuration
ACTIVE_STORAGE_SERVICE=local

# Chatwoot specific
CHATWOOT_HUB_URL=https://hub.chatwoot.com
USE_INBOX_AVATAR_FOR_BOT=true